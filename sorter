#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <Servo.h>
#include <SoftwareSerial.h>

// ---------------- OLED ----------------
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_ADDR 0x3C
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);

// ---------------- PINS ----------------
#define MOISTURE_PIN A0
#define SERVO_PIN 8
#define TRIG_PIN 6
#define ECHO_PIN 7

#define BT_RX 10
#define BT_TX 11
SoftwareSerial BT(BT_RX, BT_TX);

// ---------------- OBJECTS ----------------
Servo myServo;

// ---------------- VARIABLES ----------------
int wetCount = 0;
int dryCount = 0;

bool actionLock = false;

unsigned long decisionStart = 0;
unsigned long previousMillis = 0;

int state = 0;
// 0 = Ready
// 1 = Waiting decision (1 sec)
// 2 = Result
// 3 = Thank You

// ---------------- SETTINGS ----------------
#define WET_THRESHOLD 480

// ---------------- DISPLAY ----------------
void updateDisplay(const char* message) {
  display.clearDisplay();

  display.setTextColor(SSD1306_WHITE);

  display.setTextSize(2);
  display.setCursor(0, 0);
  display.print("W=");
  display.print(wetCount);
  display.print(" D=");
  display.print(dryCount);

  display.setCursor(10, 30);
  display.print(message);

  display.display();
}

// ---------------- ULTRASONIC ----------------
int getDistance() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  long dur = pulseIn(ECHO_PIN, HIGH, 20000);
  if (dur == 0) return 999;

  return dur * 0.034 / 2;
}

// ---------------- SETUP ----------------
void setup() {
  Serial.begin(9600);
  BT.begin(9600);

  display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR);

  display.clearDisplay();
  display.setTextSize(2);
  display.setCursor(10, 20);
  display.print("VERDEON");
  display.display();
  delay(1500);

  updateDisplay("VERDEON");

  myServo.attach(SERVO_PIN);
  myServo.write(90);

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
}

// ---------------- LOOP ----------------
void loop() {

  int distance = getDistance();
  int moisture = analogRead(MOISTURE_PIN);
  unsigned long currentMillis = millis();

  Serial.print("Moisture: ");
  Serial.println(moisture);

  // -------- PRIORITY: MOISTURE DIRECT --------
  if (!actionLock && moisture < WET_THRESHOLD) {

    wetCount++;
    updateDisplay("WET WASTE");
    myServo.write(30);

    delay(2000);

    myServo.write(90);
    updateDisplay("Thank You");
    delay(2000);

    updateDisplay("VERDEON");

    actionLock = true;
  }

  // -------- ULTRASONIC TRIGGER --------
  if (!actionLock && distance < 3) {
    decisionStart = currentMillis;
    state = 1;
    actionLock = true;
  }

  // -------- WAIT 1 SECOND THEN DECIDE --------
  if (state == 1 && currentMillis - decisionStart >= 1000) {

    int moistureNow = analogRead(MOISTURE_PIN);

    if (moistureNow < WET_THRESHOLD) {
      wetCount++;
      updateDisplay("WET WASTE");
      myServo.write(30);

      if (wetCount >= 3) {
        BT.print("VERDEON ALERT: Wet waste full\r\n");
        wetCount = 0;
      }
    } else {
      dryCount++;
      updateDisplay("DRY WASTE");
      myServo.write(150);

      if (dryCount >= 3) {
        BT.print("VERDEON ALERT: Dry waste full\r\n");
        dryCount = 0;
      }
    }

    previousMillis = currentMillis;
    state = 2;
  }

  // -------- HOLD RESULT --------
  if (state == 2 && currentMillis - previousMillis > 2000) {
    myServo.write(90);
    updateDisplay("Thank You");

    previousMillis = currentMillis;
    state = 3;
  }

  // -------- BACK TO READY --------
  if (state == 3 && currentMillis - previousMillis > 2000) {
    updateDisplay("VERDEON");
    state = 0;
  }

  // -------- RESET LOCK --------
  if (distance > 10 && moisture > WET_THRESHOLD) {
    actionLock = false;
  }

  delay(50);
}
